{
  "name": "lexiflow-ielts",
  "private": true,
  "version": "1.0.0",
  "description": "Lexiflow IELTS vocabulary desktop app",
  "author": "Lexiflow",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --port=3000 --strictPort --host 127.0.0.1",
    "dev:electron": "node electron/dev.cjs",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('release',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "start": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.lexiflow.ielts",
    "productName": "Lexiflow IELTS",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.ico"
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Lexiflow-IELTS-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.0.10"
  }
}
